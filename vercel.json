{
  "version": 2,
  "public": true,
  "outputDirectory": "frontend",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "https://geoalertner.onrender.com/api/v1/$1"
    },
    {
      "source": "/health",
      "destination": "https://geoalertner.onrender.com/health"
    },
    {
      "source": "/docs",
      "destination": "https://geoalertner.onrender.com/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://geoalertner.onrender.com/openapi.json"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
