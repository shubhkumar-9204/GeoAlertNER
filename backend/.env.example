# GeoAlertNER Backend Environment Configuration
PROJECT_NAME="GeoAlertNER"
API_V1_STR="/api/v1"
SECRET_KEY="supersecretkey-geoalertner-dev"
DEBUG=True

# Database Configuration (SQLite default for zero-setup, replace with PostgreSQL/PostGIS for production)
DATABASE_URL="sqlite:///./geoalertner.db"
# Example PostgreSQL PostGIS: DATABASE_URL="postgresql://postgres:password@localhost:5432/geoalert_ner"

# External Weather & Terrain APIs
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1/forecast"
OPEN_METEO_ELEVATION_URL="https://api.open-meteo.com/v1/elevation"

# OpenRouteService (Optional key for extended features, fallback local router included)
OPENROUTESERVICE_API_KEY=""

# SMS Alert Gateway (Fast2SMS / Twilio - optional mock enabled by default)
SMS_GATEWAY_PROVIDER="MOCK"
SMS_API_KEY=""

# Default Location Focus: Guwahati / Shillong (North Eastern Region, India)
DEFAULT_LATITUDE=26.1445
DEFAULT_LONGITUDE=91.7362
