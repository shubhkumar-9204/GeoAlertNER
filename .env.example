# GeoAlertNER Environment Variables
# Copy this file to .env and fill in the actual values before running Docker.

# ── Security ─────────────────────────────────────────────────────────────────
# IMPORTANT: Replace with a long random secret in production!
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-secret

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default, suitable for single-server deployments)
DATABASE_URL=sqlite:////app/data/geoalertner.db

# ── External Integrations ─────────────────────────────────────────────────────
# OpenRouteService API key for real routing (leave empty to use fallback heuristic)
OPENROUTESERVICE_API_KEY=

# SMS Gateway for emergency broadcasts (MOCK = disabled, set to FAST2SMS or TWILIO)
SMS_GATEWAY_PROVIDER=MOCK
SMS_API_KEY=

# ── Application ───────────────────────────────────────────────────────────────
DEBUG=false
